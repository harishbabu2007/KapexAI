# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (db-service).
DATABASE_URL="postgresql://user:password@host:5432/kapexai?sslmode=require"

# ── Redis ───────────────────────────────────────────────────
# Redis Cloud connection string (redis-py). Must stay reachable from both
# the backend and the worker.
REDIS_URL="redis://user:password@host:port"

# ── Auth / Google OAuth ─────────────────────────────────────
# Secret used to sign KapexAI JWTs (HS256, 7-day expiry). Pick a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Google OAuth 2.0 Web client ID — used by:
#   * GET  /auth/google          (builds the OAuth redirect URL)
#   * POST /auth/google          (verifies the popup ID token — audience check)
# It MUST match the VITE_GOOGLE_CLIENT_ID used by the frontend.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Only needed if you use the redirect OAuth flow (GET /auth/google/callback).
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Include your Vercel frontend URL (e.g., https://your-app.vercel.app)
CORS_ORIGINS="http://localhost:3000,https://your-app.vercel.app"

# ── LLM / tools (worker) ────────────────────────────────────
# Google Gemini for the chat/router/questionnaire/SWOT agents.
GOOGLE_API_KEY="your-google-api-key"

# Tavily for the web-search tool and Indian regulatory discovery.
TAVILY_API_KEY="your-tavily-api-key"

# Indian Kanoon API — token for the Indian case-law search tool.
# https://indiankanoon.org/ (free trial credits; token-based auth).
INDIANKANOON_API_TOKEN="your-indian-kanoon-api-token"
# SEC for the finance tool's public-company filing lookups (data.sec.gov).
# SEC requires a User-Agent identifying the application and a contact email.
SEC_USER_AGENT="YourAppName contact@example.com"

# ── Feedback → Google Sheets ───────────────────────────────────
# Optional feature. Leave FEEDBACK_ENABLED unset/false and the Feedback button
# never appears; nothing else changes. See docs/feedback.md.
FEEDBACK_ENABLED="false"

# Target spreadsheet and the tab that holds the feedback table. The tab must
# already exist with these headers in row 1, columns A–J:
#   feedback_id, created_at_utc, user_id, category, message, page_path,
#   session_id, contact_allowed, contact_email, status
FEEDBACK_SPREADSHEET_ID="your-google-spreadsheet-id"
FEEDBACK_SHEET_NAME="Feedback"

# Credentials: use ONE of the two below. Both are backend-only — never expose
# either to the frontend.
#   • Local development: absolute path to the service-account key file.
FEEDBACK_GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/feedback-service-account.json"
#   • Deployment: the same key inlined as JSON, so no file needs to exist in
#     the image. Quote it carefully — newlines must be escaped as \n.
# FEEDBACK_GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}'
